generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  name               String
  phone              String?
  passwordHash       String
  role               Role                 @default(CUSTOMER)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  emailVerified          Boolean              @default(false)
  auditLogs              AuditLog[]
  orders                 Order[]
  statusChanges          OrderStatusHistory[]
  PasswordResetToken     PasswordResetToken[]
  staffAssignments       StaffAssignment[]
  UserPreference         UserPreference?
  verifiedPayments       Payment[]            @relation("PaymentVerifiedBy")
  confirmedOrderPayments Order[]              @relation("OrderPaymentConfirmedBy")
  verifiedOrderPickups   Order[]              @relation("OrderPickupVerifiedBy")

  @@index([email])
  @@index([role])
}

model Canteen {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  description      String?
  location         String
  openingTime      String            @default("08:00")
  closingTime      String            @default("21:00")
  isActive         Boolean           @default(true)
  imageUrl             String?
  paymentQrEnabled     Boolean           @default(true)
  paymentUpiId         String?           @default("avi258369@oksbi")
  paymentPayeeName     String?           @default("Santosh Reddy")
  paymentQrImageUrl    String?           @default("/images/upi-payment-qr.jpg")
  paymentInstructions  String?           @default("Scan with any UPI app (Google Pay / PhonePe / Paytm / BHIM) to Santosh Reddy (avi258369@oksbi) or pay cash at the pickup counter.")
  paymentPolicy        String            @default("PAY_BEFORE_PICKUP")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  categories           Category[]
  menuItems        MenuItem[]
  orders           Order[]
  pickupSlots      PickupSlot[]
  promotions       Promotion[]
  staffAssignments StaffAssignment[]

  @@index([slug])
  @@index([isActive])
}

model StaffAssignment {
  id        String   @id @default(uuid())
  userId    String
  canteenId String
  staffRole String   @default("KITCHEN_STAFF")
  createdAt DateTime @default(now())
  canteen   Canteen  @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canteenId])
  @@index([userId])
  @@index([canteenId])
}

model Category {
  id        String      @id @default(uuid())
  canteenId String
  name      String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  canteen   Canteen     @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
  Promotion Promotion[]

  @@unique([canteenId, name])
  @@index([canteenId])
}

model MenuItem {
  id                     String           @id @default(uuid())
  canteenId              String
  categoryId             String
  name                   String
  description            String?
  price                  Decimal          @db.Decimal(10, 2)
  imageUrl               String?
  isVeg                  Boolean          @default(true)
  isAvailable            Boolean          @default(true)
  preparationTimeMinutes Int              @default(15)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  inventory              InventoryRecord?
  canteen                Canteen          @relation(fields: [canteenId], references: [id], onDelete: Cascade)
  category               Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  Promotion              Promotion[]

  @@index([canteenId])
  @@index([categoryId])
  @@index([isAvailable])
}

model InventoryRecord {
  id            String   @id @default(uuid())
  menuItemId    String   @unique
  currentStock  Int      @default(50)
  lowStockAlert Int      @default(10)
  isUnlimited   Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model PickupSlot {
  id              String   @id @default(uuid())
  canteenId       String
  date            String
  startTime       String
  endTime         String
  maxCapacity     Int      @default(20)
  currentBookings Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
  canteen         Canteen  @relation(fields: [canteenId], references: [id], onDelete: Cascade)

  @@unique([canteenId, date, startTime, endTime])
  @@index([canteenId, date])
  @@index([isActive])
}

model Order {
  id                  String               @id @default(uuid())
  orderNumber         String               @unique
  customerId          String
  canteenId           String
  pickupSlotId        String
  status              OrderStatus          @default(PLACED)
  subtotal            Decimal              @db.Decimal(10, 2)
  tax                 Decimal              @default(0.00) @db.Decimal(10, 2)
  convenienceFee      Decimal              @default(0.00) @db.Decimal(10, 2)
  total               Decimal              @db.Decimal(10, 2)
  specialInstructions String?
  rejectionReason     String?
  cancellationReason  String?
  pickupToken         String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  discount                     Decimal              @default(0.00) @db.Decimal(10, 2)
  promotionId                  String?
  guestTrackingTokenHash       String?
  trackingTokenExpiresAt       DateTime?
  paymentCollectionConfirmedAt DateTime?
  paymentConfirmedByStaffId    String?
  pickupVerifiedAt             DateTime?
  pickupVerifiedByStaffId      String?
  canteen                      Canteen              @relation(fields: [canteenId], references: [id])
  customer                     User                 @relation(fields: [customerId], references: [id])
  pickupSlot                   PickupSlot           @relation(fields: [pickupSlotId], references: [id])
  Promotion                    Promotion?           @relation(fields: [promotionId], references: [id])
  paymentConfirmedByStaff      User?                @relation("OrderPaymentConfirmedBy", fields: [paymentConfirmedByStaffId], references: [id])
  pickupVerifiedByStaff        User?                @relation("OrderPickupVerifiedBy", fields: [pickupVerifiedByStaffId], references: [id])
  items                        OrderItem[]
  statusHistory                OrderStatusHistory[]
  payment                      Payment?

  @@index([customerId])
  @@index([canteenId])
  @@index([status])
  @@index([pickupSlotId])
  @@index([createdAt])
  @@index([guestTrackingTokenHash])
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  menuItemId        String
  nameSnapshot      String
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  quantity          Int
  subtotal          Decimal  @db.Decimal(10, 2)
  notes             String?
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id])
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  method            PaymentMethod @default(SIMULATED_CARD)
  status            PaymentStatus @default(PENDING)
  transactionRef    String?       @unique
  isSimulated       Boolean       @default(true)
  verifiedByStaffId String?
  verifiedAt        DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedByStaff   User?         @relation("PaymentVerifiedBy", fields: [verifiedByStaffId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([verifiedByStaffId])
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime     @default(now())
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id])
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Promotion {
  id                  String                @id @default(uuid())
  title               String
  subtitle            String?
  description         String
  imageUrl            String
  discountType        String                @default("PERCENTAGE")
  discountValue       Decimal               @default(0) @db.Decimal(10, 2)
  promoCode           String?               @unique
  canteenId           String?
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  priority            Int                   @default(1)
  badge               String?
  maxDiscount         Decimal?              @db.Decimal(10, 2)
  minOrderValue       Decimal               @default(0) @db.Decimal(10, 2)
  placement           String                @default("HERO_CAROUSEL")
  targetCategoryId    String?
  targetMenuItemId    String?
  Order               Order[]
  canteen             Canteen?              @relation(fields: [canteenId], references: [id])
  Category            Category?             @relation(fields: [targetCategoryId], references: [id])
  MenuItem            MenuItem?             @relation(fields: [targetMenuItemId], references: [id])
  PromotionClick      PromotionClick[]
  PromotionImpression PromotionImpression[]

  @@index([isActive])
  @@index([placement])
  @@index([startDate, endDate])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PromotionClick {
  id          String    @id @default(uuid())
  promotionId String
  userId      String?
  createdAt   DateTime  @default(now())
  Promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([userId])
}

model PromotionImpression {
  id          String    @id @default(uuid())
  promotionId String
  userId      String?
  createdAt   DateTime  @default(now())
  Promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([userId])
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  dietaryPreference String   @default("ANY")
  favoriteCanteenId String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id           String   @id @default(uuid())
  orderId      String?
  recipient    String
  subject      String
  templateType String
  status       String   @default("SENT")
  errorMessage String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([recipient])
  @@index([createdAt])
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COLLECTED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI_QR
  CASH_AT_COUNTER
  SIMULATED_CARD
  SIMULATED_UPI
  CASH_ON_PICKUP
  STRIPE_TEST
}
