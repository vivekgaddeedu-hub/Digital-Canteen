# QUICKBITE V2 - Environment Configuration Template
# Copy this file to .env and replace placeholders with actual credentials.

# Database Configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:password@localhost:5432/quickbite?schema=public"

# Authentication & Session Security (JWT)
# Generate a secure 64-character hex key in production: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# Application Base URLs
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Nodemailer SMTP Email Infrastructure
# Supported: AWS SES, SendGrid, Postmark, Mailgun, Mailtrap, or internal campus SMTP
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM_EMAIL="orders@quickbite.campus.edu"
SMTP_FROM_NAME="QUICKBITE Campus Canteen"

# Container & Docker Deployment Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="quickbite_secure_production_pass_2026"
POSTGRES_DB="quickbite"
APP_PORT=3000

# Optional Payment Gateway Configuration
# When not provided, QUICKBITE operates using its built-in Simulated UPI / Card / Cash on Pickup
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
