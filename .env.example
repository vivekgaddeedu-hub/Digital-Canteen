# QUICKBITE V3 - Environment Configuration Template
# Copy this file to .env and replace placeholders with actual credentials.
# NEVER commit your actual .env file with secrets to Git.

# Database Configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:password@localhost:5432/quickbite?schema=public"

# Authentication & Session Security (JWT)
# Generate a secure 64-character hex key in production: openssl rand -hex 32
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# Application Base URLs (Used for Email Tracking Links)
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Nodemailer SMTP Configuration
# Standard SMTP:
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp-username-placeholder"
SMTP_PASS="smtp-password-placeholder"
SMTP_FROM_EMAIL="orders@quickbite.campus.edu"
SMTP_FROM_NAME="QUICKBITE"

# Gmail SMTP Configuration (Alternative to custom SMTP):
# To use Gmail:
# 1. Enable 2-Step Verification in your Google Account security settings.
# 2. Generate a 16-character 'App Password' for Mail.
# 3. Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
# 4. Set SMTP_USER=your-email@gmail.com, SMTP_PASS=your-16-char-app-password
# GMAIL_APP_USER=""
# GMAIL_APP_PASS=""

# Canteen QR-Code Payment Defaults
DEFAULT_UPI_ID="quickbite.campus@upi"
DEFAULT_PAYMENT_POLICY="PAY_BEFORE_PICKUP"

# Container & Docker Deployment Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="quickbite_secure_production_pass_2026"
POSTGRES_DB="quickbite"
APP_PORT=3000

# Optional Payment Gateway Configuration (Mode B)
# When omitted, QuickBite operates using Mode A: Configurable UPI QR & Staff Counter Verification
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
