{
  "git.ignoreLimitWarning": true,
  "files.exclude": {
    "**/.git": true,
    "**/.pg-env": true,
    "**/.pg-data": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.pg-env": true,
    "**/.pg-data": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/*/**": true,
    "**/.next/*/**": true,
    "**/.pg-env/*/**": true,
    "**/.pg-data/*/**": true
  }
}